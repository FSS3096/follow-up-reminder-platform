# Supabase (only these two values may use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp sandbox (leave unset when using console/wa_link)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_SANDBOX_TEMPLATE_CONTENT_SID=
MESSAGE_PROVIDER=console # twilio_sandbox | wa_link | console
ALLOW_LIVE_SEND=false

# Endpoint security
CRON_SECRET=
APP_BASE_URL=http://localhost:3000

# Reviewed template values (fictional defaults)
CLINIC_NAME=Sunrise Family Clinic
CLINIC_PHONE=
DEFAULT_DOCTOR_NAME=Dr. Mehra
DEFAULT_TIMEZONE=Asia/Kolkata
CLINIC_CLOSED_DAYS=

# Optional LLM parsing is not implemented in v1; keep disabled
ENABLE_LLM_PARSER=false
GEMINI_API_KEY=

# Modeled-value placeholders; replace with defensible clinic assumptions
PATIENTS_PER_DAY=50
BASELINE_MISS_RATE=0.30
FOLLOWUP_SHARE=0.40
RECOVERY_RATE=0.50
AVG_FEE_INR=300
WORKING_DAYS_PER_MONTH=26

# Optional real team demo phones, only with consent; never commit these values
DEMO_PHONE_1=
DEMO_PHONE_2=
DEMO_PHONE_3=
